{
  "name": "margin-local",
  "version": "1.2.0",
  "private": true,
  "description": "Margin — a local reading library for turning video transcripts into readable, annotatable articles.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components hooks lib",
    "check:local": "node local-tools/check-localhost.mjs",
    "check:api": "node --experimental-strip-types local-tools/check-api-contracts.ts",
    "verify": "tsc --noEmit && node local-tools/check-localhost.mjs && node --experimental-strip-types local-tools/check-api-contracts.ts && node --experimental-strip-types local-tools/check-reader-renderer.ts",
    "check:reader": "node --experimental-strip-types local-tools/check-reader-renderer.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-youtube-transcript": "1.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
